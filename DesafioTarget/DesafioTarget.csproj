<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Comissao\Files\" />
    <Folder Include="Estoque\Files\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Comissao\Files\vendas.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Estoque\Files\estoque.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties estoque_4files_4estoque_1json__JsonSchema="copy to output " /></VisualStudio></ProjectExtensions>

</Project>
